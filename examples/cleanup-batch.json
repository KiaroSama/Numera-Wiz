{
  "items": [
    {
      "asset_id": "REPLACE_ASSET_A",
      "output": "exports/first-clean.mkv"
    },
    {
      "asset_id": "REPLACE_ASSET_B",
      "output": "exports/second-clean.mkv"
    }
  ],
  "intent": {
    "audio_selection": {
      "selector": {
        "mode": "languages",
        "values": [
          "eng"
        ]
      },
      "no_match": "skip_file"
    },
    "subtitle_selection": {
      "selector": {
        "mode": "all"
      },
      "no_match": "allow_empty"
    },
    "audio_order": [],
    "subtitle_order": [],
    "stream_tag_patches": [],
    "preservation": {
      "additional_video": true,
      "attached_pictures": true,
      "attachments": true,
      "data": true,
      "unknown": true,
      "global_tags": true,
      "stream_tags": true,
      "chapters": true,
      "dispositions": true
    }
  },
  "file_times": "preserve_best_effort",
  "execution_limits": {
    "probe": {
      "mode": "finite",
      "seconds": 120
    },
    "operation": {
      "mode": "finite",
      "seconds": 10800
    }
  },
  "failure_policy": "reject_all",
  "unresolved_policy": "reject"
}
